---
layout: layouts/base.njk
title: "Lovelock (1965): the paper, with reading support"
tagline: The reader opens in its own window. The glosses, the definitions, and the word list stay here.
# The interactive reader (Apps Script web app, restricted to the school domain).
# Linked, not embedded: script.google.com sends frame-ancestors 'self', and the
# Google sign-in it redirects to sends X-Frame-Options: DENY, so an iframe here
# only ever rendered "refused to connect". The link opens in a new window, and
# Google enforces the school-domain check on the way in.
readerUrl: "https://script.google.com/a/macros/aischennai.org/s/AKfycbzvHydkVLoECz1ouDtkD31CfhCGam3XZ-7wKvAF2O4FTKoDHbwEOkZN9qhQJlObcyFg/exec"
extraStylesheets:
  - /assets/reading-page.css
breadcrumbs:
  - { url: /, label: Home }
  - { url: /units/unit-0/, label: "Unit 0: Scientific Practices & Class Foundations" }
  - { url: /units/unit-0/block-2/, label: "Block 2: OPVL Across Source Types" }
  - { label: "Lovelock (1965) reading support" }
returnTo:
  - { url: /units/unit-0/block-2/, label: "Block 2: OPVL Across Source Types" }
---

{%- set glossary = lovelockGlossary -%}
{%- set terms = glossary.terms -%}
{%- set total = lovelockSlides.slides | length -%}
{#- Terms the nine steps actually use, so the word list can mark them. -#}
{%- set slideTerms = [] -%}
{%- for s in lovelockSlides.slides -%}{%- for t in s.terms -%}
{%- set slideTerms = (slideTerms.push(t), slideTerms) -%}
{%- endfor -%}{%- endfor -%}

{%- if readerUrl %}
<section class="reader-launch">
  <h2>Start here: the interactive reader</h2>
  <p>The paper with the reading supports built into it. It opens in a new window, so keep this page in the tab behind it for the glosses and the word list.</p>
  <a class="reader-open-btn" href="{{ readerUrl }}" target="_blank" rel="noopener">Open the interactive reader</a>
  <p class="reader-launch-note">Sign in with your school Google account. The reader is restricted to AISC accounts, so it will not open for anyone outside the school.</p>
</section>
{%- else %}
<section class="reader-launch placeholder-frame">
  <span class="placeholder-tag">Not connected yet</span>
  <p><strong>The reader is not pointed at a deployment yet.</strong></p>
  <p>Paste the Apps Script web app URL into <code>readerUrl</code> at the top of this page's source.</p>
</section>
{%- endif %}

<section class="verify-banner" aria-label="About the translations on this page">
  <p>The translations on this page were generated by an AI and have NOT been checked by a human. If you speak one of these languages, you know more than the machine does. Found one that is wrong, awkward, or means something different in science than in ordinary use? Tell your teacher: corrections get your name on them, and a wrong translation you catch counts as a documented AI error.</p>
</section>

<div class="reading-controls">
  <div class="lang-select">
    <label for="lang">Definitions also in</label>
    <select id="lang" name="lang">
      <option value="none">none (English only)</option>
      {%- for code, label in glossary.languages %}
      <option value="{{ code }}">{{ label }}</option>
      {%- endfor %}
    </select>
  </div>
  <p class="reading-lede">Definitions open where the word is used. Pick a language above and they appear alongside the English.</p>
</div>

<div class="reading-support">

  <div class="support-body">

    <section class="rail-block">
      <h2>The argument, one step at a time</h2>
      <p class="rail-sub">Nine short steps through what the paper says. Read these first if the paper is hard going, then go back to it knowing what you are looking for. This is not the paper, and your OPVL is on the paper.</p>

      {#- Every slide ships in the DOM. JavaScript adds the `hidden` attribute to
          all but one; with JavaScript off nothing is hidden, the nav never
          unhides, and the section reads as a plain numbered list. #}
      <div class="slides" id="lovelock-slides" aria-roledescription="carousel" aria-label="The argument, one step at a time">
        <p class="sr-only slides-live" aria-live="polite"></p>
        <div class="slide-list">
          {%- for s in lovelockSlides.slides %}
          <div class="slide{% if s.isTask %} is-task{% endif %}" aria-roledescription="slide" aria-label="Step {{ s.n }} of {{ total }}">
            <p class="slide-count">Step {{ s.n }} of {{ total }}</p>
            <h3 class="slide-title" tabindex="-1">{{ s.title }}</h3>
            <p class="slide-body">{{ s.body }}</p>
            {%- if s.image %}
            <figure class="slide-figure">
              <img src="{{ s.image }}" alt="{{ s.imageAlt }}">
            </figure>
            {%- endif %}
            {%- if s.terms.length %}
            <p class="slide-terms">
              <span class="slide-terms-label">Key words:</span>
              {%- for t in s.terms %}
              <button type="button" class="term" data-term="{{ t | termSlug }}" aria-expanded="false">{{ t }}</button>
              {%- endfor %}
            </p>
            {%- endif %}
            {%- if s.find %}
            <p class="slide-find">Find it in the paper: <q>{{ s.find }}</q></p>
            {%- endif %}
          </div>
          {%- endfor %}
        </div>
        <div class="slide-nav" hidden>
          <button type="button" class="slide-btn slide-prev">Previous</button>
          <span class="slide-pos" aria-hidden="true">Step 1 of {{ total }}</span>
          <button type="button" class="slide-btn slide-next">Next</button>
        </div>
        <p class="slide-showall-row" hidden>
          <button type="button" class="slide-showall" aria-pressed="false">Show all steps</button>
        </p>
      </div>
    </section>

    <section class="rail-block">
      <h2>Read for Origin and Purpose</h2>
      <ul class="rail-origin">
        <li>The title and author block</li>
        <li>The <em>Nature</em> citation line</li>
        <li>The Acknowledgements paragraph</li>
        <li>The NASA grant sentence</li>
        <li>The References list</li>
      </ul>
      <p class="sic-note">The scanned PDF contains a couple of obvious errors where the scanner misread a letter, words that are clearly not what Lovelock wrote. The class reading tool corrects them back to the 1965 printed text. They are worth noticing anyway: you are reading a machine's copy of a printed page, not the page, and that belongs in your Origin.</p>
    </section>

    <section class="rail-block word-list" aria-label="Word list">
      <h2>Word list</h2>
      <p class="rail-sub">All {{ terms | length }} words from the paper, in the order Lovelock uses them. The {{ slideTerms | length }} tagged <span class="wl-tag">in the steps</span> are the ones the nine steps above explain; the rest turn up elsewhere in the paper, so they are here for when you are reading it yourself.</p>
      <ul class="wl-list">
        {%- for entry in terms %}
        <li class="wl-entry{% if entry.term in slideTerms %} is-slide{% endif %}" id="wl-{{ entry.term | termSlug }}">
          <p class="wl-head">
            <strong>{{ entry.term }}</strong>
            <span class="wl-pos">{{ entry.pos }}</span>
            {%- if entry.term in slideTerms %} <span class="wl-tag">in the steps</span>{% endif %}
          </p>
          <p class="wl-plain">{{ entry.plain }}</p>
          {%- if entry.note %}<p class="wl-note">{{ entry.note }}</p>{% endif %}
        </li>
        {%- endfor %}
      </ul>
    </section>

  </div>
</div>

{#- Cards live outside the support column and move next to the tapped word. -#}
<div class="term-cards">
  {%- for entry in terms %}
  <div class="term-card" id="term-{{ entry.term | termSlug }}" hidden>
    <p class="tc-head"><strong>{{ entry.term }}</strong> <span class="tc-pos">{{ entry.pos }}</span></p>
    <p class="tc-plain">{{ entry.plain }}</p>
    {%- if entry.note %}<p class="tc-note">{{ entry.note }}</p>{% endif %}
    {%- for code, label in glossary.languages %}
    {%- set translation = entry.t[code] %}
    {%- if translation %}
    <p class="tc-translation{% if entry.verifiedBy and entry.verifiedBy[code] %} is-verified{% endif %}" data-lang="{{ code }}" hidden>
      <span class="tc-lang">{{ label }}</span>
      <span class="tc-term">{{ translation }}</span>
      {%- if entry.verifiedBy and entry.verifiedBy[code] %}
      <span class="tc-verified">verified by {{ entry.verifiedBy[code] }}{% if entry.verifiedDate and entry.verifiedDate[code] %}, {{ entry.verifiedDate[code] }}{% endif %}</span>
      {%- else %}
      <span class="tc-unverified">unverified</span>
      {%- endif %}
    </p>
    {%- endif %}
    {%- endfor %}
    {%- if entry.flag %}<p class="tc-flag">{{ entry.flag }}</p>{% endif %}
    <p class="tc-links"><a href="/reference/glossary/u0-lovelock-1965/#term-{{ entry.term | termSlug }}">Also in: course glossary</a></p>
  </div>
  {%- endfor %}
</div>


<script>
(function () {
  var LANG_KEY = "ees-reading-lang";
  var cards = document.querySelector(".term-cards");
  var langSelect = document.getElementById("lang");

  function applyLanguage(code) {
    document.querySelectorAll(".tc-translation").forEach(function (row) {
      row.hidden = code === "none" || row.getAttribute("data-lang") !== code;
    });
  }

  var stored = null;
  try { stored = localStorage.getItem(LANG_KEY); } catch (e) {}
  if (stored) { langSelect.value = stored; }
  applyLanguage(langSelect.value);

  langSelect.addEventListener("change", function () {
    applyLanguage(langSelect.value);
    try { localStorage.setItem(LANG_KEY, langSelect.value); } catch (e) {}
  });

  var openButton = null;
  function closeCard() {
    if (!openButton) { return; }
    var card = document.getElementById("term-" + openButton.getAttribute("data-term"));
    if (card) { card.hidden = true; cards.appendChild(card); }
    openButton.setAttribute("aria-expanded", "false");
    openButton = null;
  }

  document.addEventListener("click", function (event) {
    var button = event.target.closest("button.term");
    if (!button) {
      if (!event.target.closest(".term-card")) { closeCard(); }
      return;
    }
    var wasOpen = button === openButton;
    closeCard();
    if (wasOpen) { return; }
    var card = document.getElementById("term-" + button.getAttribute("data-term"));
    if (!card) { return; }
    var host = button.closest("li") || button.parentNode;
    host.parentNode.insertBefore(card, host.nextSibling);
    card.hidden = false;
    button.setAttribute("aria-expanded", "true");
    openButton = button;
  });

  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape") { closeCard(); }
  });

})();

/* The argument carousel. Nothing here runs on a timer and nothing auto-advances:
   this component is for students who already find reading hard, and a slide that
   moves on its own is worse than no slides at all. */
(function () {
  var root = document.getElementById("lovelock-slides");
  if (!root) { return; }
  var slides = Array.prototype.slice.call(root.querySelectorAll(".slide"));
  if (slides.length < 2) { return; }

  var nav = root.querySelector(".slide-nav");
  var prevBtn = root.querySelector(".slide-prev");
  var nextBtn = root.querySelector(".slide-next");
  var position = root.querySelector(".slide-pos");
  var live = root.querySelector(".slides-live");
  var showAllRow = root.querySelector(".slide-showall-row");
  var showAll = root.querySelector(".slide-showall");
  var index = 0;
  var expanded = false;

  function render(moveFocus) {
    slides.forEach(function (slide, i) {
      slide.hidden = !expanded && i !== index;
    });
    nav.hidden = expanded;
    prevBtn.disabled = index === 0;
    nextBtn.disabled = index === slides.length - 1;
    position.textContent = "Step " + (index + 1) + " of " + slides.length;
    if (expanded) { return; }
    var title = slides[index].querySelector(".slide-title");
    live.textContent = "Step " + (index + 1) + " of " + slides.length + ", " + title.textContent;
    if (moveFocus) { title.focus(); }
  }

  function go(to, moveFocus) {
    if (to < 0 || to >= slides.length || expanded) { return; }
    index = to;
    render(moveFocus);
  }

  prevBtn.addEventListener("click", function () { go(index - 1, true); });
  nextBtn.addEventListener("click", function () { go(index + 1, true); });

  showAll.addEventListener("click", function () {
    expanded = !expanded;
    showAll.setAttribute("aria-pressed", String(expanded));
    showAll.textContent = expanded ? "Show one step at a time" : "Show all steps";
    render(false);
    live.textContent = expanded
      ? "Showing all " + slides.length + " steps."
      : "Showing one step at a time. Step " + (index + 1) + " of " + slides.length + ".";
  });

  /* Scoped to the carousel, so arrow keys are only captured when focus is inside it. */
  root.addEventListener("keydown", function (event) {
    if (expanded) { return; }
    if (event.key === "ArrowLeft") { event.preventDefault(); go(index - 1, true); }
    else if (event.key === "ArrowRight") { event.preventDefault(); go(index + 1, true); }
  });

  /* Swipe is a bonus on top of the buttons, not a replacement for them. */
  var touchX = null;
  root.addEventListener("touchstart", function (e) {
    touchX = e.changedTouches[0].clientX;
  }, { passive: true });
  root.addEventListener("touchend", function (e) {
    if (touchX === null) { return; }
    var dx = e.changedTouches[0].clientX - touchX;
    touchX = null;
    if (Math.abs(dx) < 45) { return; }
    go(dx < 0 ? index + 1 : index - 1, false);
  }, { passive: true });

  showAllRow.hidden = false;
  render(false);
})();
</script>
