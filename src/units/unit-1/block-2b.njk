<script>
(function () {
  var key = 'steps:' + location.pathname;
  var checks = Array.prototype.slice.call(document.querySelectorAll('.step-check'));
  var progress = document.getElementById('step-progress');
  function load() { try { return JSON.parse(localStorage.getItem(key)) || []; } catch (e) { return []; } }
  function save(st) { try { localStorage.setItem(key, JSON.stringify(st)); } catch (e) {} }
  function apply() {
    var st = load(), n = 0;
    checks.forEach(function (c) {
      c.checked = !!st[c.dataset.step];
      c.closest('.step').classList.toggle('is-done', c.checked);
      if (c.checked) n++;
    });
    if (progress) progress.textContent = n + ' of ' + checks.length + ' steps done' + (n === checks.length ? '. That is the whole block.' : '');
  }
  checks.forEach(function (c) {
    c.addEventListener('change', function () { var st = load(); st[c.dataset.step] = c.checked; save(st); apply(); });
  });
  var reset = document.getElementById('step-reset');
  if (reset) reset.addEventListener('click', function () { save([]); apply(); });
  apply();
})();
</script>
