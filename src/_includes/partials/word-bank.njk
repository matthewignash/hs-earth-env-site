{#- Reusable word bank: every term from one reading, with its provenance and all
    translations. A stub page sets `bank` (the data object), `bankUnit`,
    `bankBlock`, and `bankReadingUrl`, then includes this file. To add a later
    reading's word bank, add its glossary JSON and a stub page. -#}
{%- set provenance = "Unit " ~ bankUnit ~ " · Block " ~ bankBlock -%}

<div class="callout">
  <div class="callout-title">Where these words come from</div>
  <p class="wb-source">{{ bank.source }}</p>
  <p>Read in <strong>{{ provenance }}</strong>. Every word below is one you meet in that paper. {{ bank.terms | pathTerms | length }} of the {{ bank.terms | length }} are on the <a href="{{ bankReadingUrl }}">close-reading path</a>, meaning they sit in the paragraphs that carry the argument; the rest appear elsewhere in the paper.</p>
</div>

<div class="wb-verify">
  <p>The translations below were generated by an AI and have NOT been checked by a human. If you speak one of these languages, you know more than the machine does. Found one that is wrong, awkward, or means something different in science than in ordinary use? Tell your teacher: corrections get your name on them, and a wrong translation you catch counts as a documented AI error.</p>
</div>

<ol class="wb-list">
  {%- for entry in bank.terms %}
  <li class="wb-entry{% if entry.path %} is-path{% endif %}" id="term-{{ entry.term | termSlug }}">
    <h2 class="wb-term">{{ entry.term }} <span class="wb-pos">{{ entry.pos }}</span></h2>
    <p class="wb-meta">
      <span class="wb-tag">{{ provenance }}</span>
      {%- if entry.path %}<span class="wb-tag is-path-tag">close-reading path</span>{% endif %}
    </p>
    <p class="wb-plain">{{ entry.plain }}</p>
    {%- if entry.note %}<p class="wb-note">{{ entry.note }}</p>{% endif %}
    {%- if entry.flag %}<p class="wb-flag">{{ entry.flag }}</p>{% endif %}
    <table class="wb-translations">
      <caption class="sr-only">Translations of {{ entry.term }}</caption>
      <tbody>
        {%- for code, label in bank.languages %}
        {%- if entry.t[code] %}
        <tr{% if entry.verifiedBy and entry.verifiedBy[code] %} class="is-verified"{% endif %}>
          <th scope="row">{{ label }}</th>
          <td class="wb-translation">{{ entry.t[code] }}</td>
          <td class="wb-status">
            {%- if entry.verifiedBy and entry.verifiedBy[code] -%}
            verified by {{ entry.verifiedBy[code] }}{% if entry.verifiedDate and entry.verifiedDate[code] %}, {{ entry.verifiedDate[code] }}{% endif %}
            {%- else -%}
            <span class="wb-unverified">unverified</span>
            {%- endif -%}
          </td>
        </tr>
        {%- endif %}
        {%- endfor %}
      </tbody>
    </table>
    <p class="wb-back"><a href="{{ bankReadingUrl }}">See it in the reading companion</a></p>
  </li>
  {%- endfor %}
</ol>
